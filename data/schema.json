{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evan.local/activity-data/schema.json",
  "title": "ActivityCategory",
  "description": "Per-country activity reference data for Frienday. Bundled into app at build time per ADR-0038.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "category_group", "min_age", "sort_order"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier (kebab-case)"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable label"
    },
    "category_group": {
      "type": "string",
      "enum": ["social", "active", "creative", "outdoor", "food", "culture", "volunteering"],
      "description": "Activity grouping for UI sections"
    },
    "min_age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99,
      "description": "Minimum age for this activity in this country (per local regulation)"
    },
    "sort_order": {
      "type": "integer",
      "minimum": 0,
      "description": "Display order within the category group"
    }
  }
}